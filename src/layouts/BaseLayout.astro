---
import { ClientRouter } from "astro:transitions";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { negocio } from "../data/negocio";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Patacón Burger — hamburguesas de patacón, empanadas, pasteles y chorizos de barrio.",
} = Astro.props;

const base = import.meta.env.BASE_URL;

const nav = [
  { href: base, label: "Inicio" },
  { href: `${base}menu`, label: "Menú" },
  { href: `${base}nosotros`, label: "Nosotros" },
  { href: `${base}contacto`, label: "Contacto" },
];

const ogUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og-image.png`, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: "Patacón Burger",
  image: ogImage.toString(),
  telephone: `+${negocio.numeroWhatsApp}`,
  servesCuisine: "Comida rápida colombiana",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Calle 8 Sur #31A-40, Barrio Santa Matilde, Localidad Puente Aranda",
    addressLocality: "Bogotá",
    addressRegion: "Bogotá D.C.",
    addressCountry: "CO",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: negocio.horarioSchema.dias,
    opens: negocio.horarioSchema.abre,
    closes: negocio.horarioSchema.cierra,
  },
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={ogUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Nunito+Sans:wght@400;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Patacón Burger</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Patacón Burger" />
    <meta property="og:title" content={`${title} · Patacón Burger`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Patacón Burger`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href={base}>Patacón Burger</a>
        <nav class="site-header__nav">
          {
            nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Patacón Burger — de barrio, con sazón de casa.</p>
        <p class="site-footer__small">
          © {new Date().getFullYear()} Patacón Burger. Todos los derechos reservados.
        </p>
      </div>
    </footer>

    <WhatsAppButton transition:persist />

    <style>
      .site-header {
        background: var(--color-bg);
        color: var(--color-text-light);
        position: sticky;
        top: 0;
        z-index: 40;
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .site-header__brand {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.4rem;
        text-decoration: none;
        color: var(--color-accent);
      }

      .site-header__nav {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
      }

      .site-header__nav a {
        text-decoration: none;
        color: var(--color-text-light);
        font-weight: 700;
        font-size: 0.95rem;
      }

      .site-header__nav a:hover {
        color: var(--color-accent);
      }

      .site-footer {
        background: var(--color-bg);
        color: var(--color-text-light);
        text-align: center;
        padding: 2rem 1.25rem;
        margin-top: 2rem;
      }

      .site-footer__small {
        opacity: 0.7;
        font-size: 0.85rem;
      }
    </style>

    <script>
      let revealObserver: IntersectionObserver | undefined;

      function initScrollReveal() {
        revealObserver?.disconnect();
        const elementos = document.querySelectorAll("[data-reveal]:not(.is-visible)");
        if (!elementos.length) return;

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );

        elementos.forEach((el) => revealObserver?.observe(el));
      }

      document.addEventListener("astro:page-load", initScrollReveal);
    </script>
  </body>
</html>
