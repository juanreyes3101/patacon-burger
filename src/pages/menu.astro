---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuItem from "../components/MenuItem.astro";
import { menu } from "../data/menu";
---

<BaseLayout title="Menú">
  <section class="section">
    <div class="container">
      <h1>Nuestro menú</h1>
      <p class="intro">
        Todo casero, hecho el mismo día. Precios en pesos colombianos.
      </p>

      <div class="menu-tabs" role="tablist" aria-label="Categorías del menú">
        <a href="#todas" class="menu-tabs__tab is-active" data-target="todas">Todas</a>
        {
          menu.map((categoria) => (
            <a href={`#${categoria.slug}`} class="menu-tabs__tab" data-target={categoria.slug}>
              {categoria.titulo}
            </a>
          ))
        }
      </div>

      {
        menu.map((categoria) => (
          <div class="categoria" id={categoria.slug} data-categoria={categoria.slug}>
            <h2>{categoria.titulo}</h2>
            <div class="grid">
              {categoria.items.map((item) => (
                <MenuItem item={item} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    color: #5a4636;
    margin-bottom: 1.5rem;
  }

  .menu-tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    scrollbar-width: thin;
  }

  .menu-tabs__tab {
    flex: 0 0 auto;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-text);
    background: #fff;
    border: 2px solid transparent;
    padding: 0.55em 1.1em;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(43, 27, 18, 0.08);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .menu-tabs__tab:hover {
    border-color: var(--color-accent);
  }

  .menu-tabs__tab.is-active {
    background: var(--color-primary);
    color: var(--color-text-light);
  }

  .categoria {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }
</style>

<script>
  function initMenuTabs() {
    const tabs = document.querySelectorAll(".menu-tabs__tab");
    const secciones = document.querySelectorAll(".categoria");
    if (!tabs.length) return;

    function activar(target, { scroll = true } = {}) {
      tabs.forEach((tab) =>
        tab.classList.toggle("is-active", tab.dataset.target === target)
      );
      secciones.forEach((sec) => {
        sec.hidden = target !== "todas" && sec.dataset.categoria !== target;
      });
      if (scroll) {
        const destino =
          target === "todas"
            ? document.querySelector(".menu-tabs")
            : document.getElementById(target);
        destino?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        const target = tab.dataset.target;
        activar(target);
        history.replaceState(null, "", target === "todas" ? location.pathname : `#${target}`);
      });
    });

    const hash = location.hash.replace("#", "");
    if (hash && document.getElementById(hash)) {
      activar(hash, { scroll: false });
    }
  }

  document.addEventListener("astro:page-load", initMenuTabs);
</script>
