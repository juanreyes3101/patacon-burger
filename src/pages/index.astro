---
import BaseLayout from "../layouts/BaseLayout.astro";
import MenuItem from "../components/MenuItem.astro";
import { menu } from "../data/menu";

const destacados = menu.flatMap((cat) => cat.items).filter((item) => item.destacado);
---

<BaseLayout title="Inicio">
  <section class="hero">
    <div class="container hero__inner">
      <span class="badge">Producto estrella</span>
      <h1>Patacón Burger</h1>
      <p class="hero__tagline">De barrio, con sazón de casa.</p>
      <p class="hero__desc">
        Hamburguesas hechas con patacón bien crocante en vez de pan, además de
        empanadas, pasteles y chorizos como los de toda la vida del barrio.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/menu">Ver el menú</a>
        <a class="btn btn--whatsapp" href="/contacto">Ubicación y pedidos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 data-reveal>Lo más pedido</h2>
      <div class="grid">
        {destacados.map((item) => <MenuItem item={item} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container cta-final" data-reveal>
      <h2>¿Antojo de patacón?</h2>
      <p>Escríbenos y te lo tenemos listo.</p>
      <a class="btn btn--whatsapp" href="/contacto">Hacer pedido</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-bg) 0%, #3a2113 100%);
    color: var(--color-text-light);
    padding: 4rem 0;
    text-align: center;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-accent);
    margin: 0.2em 0;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0;
  }

  .hero__desc {
    max-width: 40ch;
    opacity: 0.9;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .cta-final {
    text-align: center;
  }

  .cta-final .btn {
    margin-top: 1rem;
  }
</style>
