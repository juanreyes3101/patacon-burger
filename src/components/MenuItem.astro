---
import { Image } from "astro:assets";
import type { MenuItem } from "../data/menu";
import { imagenesProductos } from "../utils/imagenesProductos";

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;

const precioFormateado = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(item.precio);

const imagenSrc = item.imagen
  ? imagenesProductos[`/src/assets/productos/${item.imagen}`]?.default
  : undefined;

if (item.imagen && !imagenSrc) {
  console.warn(`[menu] imagen "${item.imagen}" no encontrada en src/assets/productos/`);
}
---

<article class="menu-item" data-reveal>
  {imagenSrc && (
    <Image
      src={imagenSrc}
      alt={item.nombre}
      width={400}
      height={300}
      class="menu-item__img"
    />
  )}
  <div class="menu-item__body">
    <div class="menu-item__header">
      <h3>{item.nombre}</h3>
      {item.destacado && <span class="badge">Producto estrella</span>}
    </div>
    <p class="menu-item__descripcion">{item.descripcion}</p>
    <p class="menu-item__precio">{precioFormateado}</p>
  </div>
</article>

<style>
  .menu-item {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(43, 27, 18, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .menu-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(43, 27, 18, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-item:hover {
      transform: none;
    }
  }

  .menu-item__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .menu-item__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .menu-item__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .menu-item__header h3 {
    font-size: 1.1rem;
    margin: 0;
  }

  .menu-item__descripcion {
    margin: 0;
    color: #5a4636;
    font-size: 0.95rem;
  }

  .menu-item__precio {
    margin: 0;
    font-weight: 800;
    color: var(--color-primary);
  }
</style>
